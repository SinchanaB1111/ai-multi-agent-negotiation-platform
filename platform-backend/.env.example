# NegoSphere FastAPI backend
APP_ENV=development
AUTH_SECRET_KEY=change-this-local-secret
DATABASE_URL=sqlite:///./negotiation.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DEV_SHOW_OTP=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=NegoSphere <your-gmail@gmail.com>
MAIL_SERVICE_URL=https://otp-mail-service.vercel.app/api/send-otp
MAIL_SERVICE_SECRET=
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Social sign-in (OAuth/OIDC)
# Register these apps with the provider and use the callback URLs documented in SOCIAL_LOGIN_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:8000
